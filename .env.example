# Your Freshdesk subdomain: "acme" or "acme.freshdesk.com"
FRESHDESK_DOMAIN=your-subdomain
# Profile settings → View API key. Never commit the real value.
FRESHDESK_API_KEY=replace-me

# Optional tuning (defaults shown)
# FRESHDESK_TIMEOUT_MS=15000
# FRESHDESK_MAX_RETRIES=3
# FRESHDESK_MAX_RETRY_WAIT_S=30
# FRESHDESK_MAX_CONCURRENCY=2

# HTTP transport (for hosted platforms that connect by URL)
# MCP_TRANSPORT=http
# MCP_HTTP_TOKEN=generate-with-openssl-rand-hex-24
# HOST=127.0.0.1
# PORT=3000
