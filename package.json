{
  "name": "freshdesk-mcp-connector",
  "version": "0.1.0",
  "description": "Read-only MCP connector that lets an agent read Freshdesk tickets, conversations and contacts",
  "private": true,
  "type": "module",
  "bin": { "freshdesk-mcp": "dist/index.js" },
  "engines": { "node": ">=22.12" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs:tools": "tsx scripts/gen-tool-docs.ts",
    "seed": "tsx scripts/seed.ts",
    "smoke": "npm run build && tsx scripts/smoke.ts",
    "inspect": "npm run build && npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "msw": "^3.0.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
